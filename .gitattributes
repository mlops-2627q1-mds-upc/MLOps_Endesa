# Keep text bytes identical across Windows, macOS and Linux
# so DVC input checksums and version hashes remain stable.
* text=auto eol=lf

# Files that must keep LF line endings on every platform
Makefile  text eol=lf
*.sh      text eol=lf

# Binary files
*.png     binary
*.jpg     binary
*.pdf     binary
*.zip     binary
*.parquet binary
