# Temporary working files (from the team working agreement, PR #4)
temporary/

# Data: folders are kept with .gitkeep; contents are versioned with DVC, not Git
/data/*/*
!/data/*/.gitkeep

# Model weights and checkpoints (versioned with DVC / MLflow)
# Require a child name so DVC can traverse models/ to discover its .dvc files.
/models/?*
!/models/.gitkeep
# DVC references to selected models; their weights stay ignored
!/models/*.dvc
!/models/*.provenance.json

# Secrets and local configuration
.env
.env.*
!.env.template

# Python environments (the environment is reproduced with `uv sync` from uv.lock)
.venv/
venv/

# Legacy GX runtime output; new Data Docs live in ignored gx/uncommitted/data_docs/.
/gx/data_docs/

# Experiment tracking and energy logs produced locally
mlruns/
mlartifacts/
mlflow.db
mlflow.db-*
emissions.csv
/reports/evaluation/
/reports/inference/
/reports/minimum-functionality/
/reports/directional/
/reports/invariance/
/reports/fine-tuning/

# Python caches and build outputs
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.cache

# Notebooks
.ipynb_checkpoints/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Logs
*.log
