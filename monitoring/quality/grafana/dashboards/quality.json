{
  "uid": "endesa-quality",
  "title": "Endesa forecast quality",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "15s",
  "tags": [
    "endesa",
    "historical-replay",
    "forecast-quality"
  ],
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "state",
        "label": "Horizon table state",
        "type": "custom",
        "query": "NSW,VIC,QLD,SA,TAS",
        "current": {
          "text": "NSW",
          "value": "NSW"
        },
        "options": [
          {
            "text": "NSW",
            "value": "NSW",
            "selected": true
          },
          {
            "text": "VIC",
            "value": "VIC",
            "selected": false
          },
          {
            "text": "QLD",
            "value": "QLD",
            "selected": false
          },
          {
            "text": "SA",
            "value": "SA",
            "selected": false
          },
          {
            "text": "TAS",
            "value": "TAS",
            "selected": false
          }
        ],
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Historical replay scope and sample meaning",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Selected p50 and lag48 use identical released rows. Source-scale errors; MASE uses training lag336. Coverage is descriptive, with no calibration SLO. Each group needs its report-declared sample minimum. Overlapping forecast errors are correlated; unique targets are separate counts. Report age measures refresh time, not new observations. Exact origin interval, model/settings, source and config identities remain in report.json. Status: 0 no forecasts, 1 pending observations, 2 insufficient samples, 3 sufficient."
      }
    },
    {
      "id": 2,
      "title": "Exporter scrape reachable (1/0)",
      "type": "stat",
      "description": "A failed scrape is 0; absent target data stays absent.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "endesa-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No current evidence",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"forecast-quality\"}",
          "legendFormat": "{{instance}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "title": "Valid fresh report available (1/0)",
      "type": "stat",
      "description": "0 covers missing, invalid or stale reports. Quality panels omit these measurements.",
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "endesa-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No current evidence",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "endesa_quality_report_available{job=\"forecast-quality\"} and on(job, instance) (up{job=\"forecast-quality\"} == 1)",
          "legendFormat": "{{instance}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "title": "Report refresh age",
      "type": "stat",
      "description": "Age of report publication, not observation age or replay progress.",
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "endesa-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No current evidence",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "endesa_quality_report_age_seconds{job=\"forecast-quality\"} and on(job, instance) (up{job=\"forecast-quality\"} == 1)",
          "legendFormat": "{{instance}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "title": "State MAE on identical matched rows",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 7
