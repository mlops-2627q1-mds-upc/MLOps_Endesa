          "refId": "A",
          "expr": "endesa_quality_empirical_coverage{job=\"forecast-quality\",state=\"$state\",horizon!=\"all\",model_role=\"selected\"} and on(job, instance) (up{job=\"forecast-quality\"} == 1) and on(job, instance) (endesa_quality_report_available{job=\"forecast-quality\"} == 1)",
          "legendFormat": "{{horizon}}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "horizon",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "horizon",
                "desc": false
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "instance": true,
              "state": true,
              "model_role": true,
              "__name__": true
            },
            "renameByName": {
              "horizon": "Horizon",
              "Value": "Horizon empirical coverage"
            }
          }
        }
