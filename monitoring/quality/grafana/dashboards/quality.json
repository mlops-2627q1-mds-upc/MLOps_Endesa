        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "endesa_quality_mae{job=\"forecast-quality\",horizon=\"all\",model_role=\"selected\"} and on(job, instance) (up{job=\"forecast-quality\"} == 1) and on(job, instance) (endesa_quality_report_available{job=\"forecast-quality\"} == 1)",
          "legendFormat": "{{state}} selected",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "endesa_quality_mae{job=\"forecast-quality\",horizon=\"all\",model_role=\"seasonal_lag48\"} and on(job, instance) (up{job=\"forecast-quality\"} == 1) and on(job, instance) (endesa_quality_report_available{job=\"forecast-quality\"} == 1)",
          "legendFormat": "{{state}} seasonal_lag48",
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
